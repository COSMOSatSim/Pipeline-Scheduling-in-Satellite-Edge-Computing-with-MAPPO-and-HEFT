// =========================================================================
// 4096-generalization.json5
// Suite di confronto: i dieci scenari di test a 4096 px, lo specialista di
// ciascuno contro i quattro metodi di generalizzazione e la baseline.
//
// Letta da CONTROL_PANEL.run = "evaluation" quando EVALUATION.suite punta qui.
// I risultati finiscono in data/results/evaluation/<output>/<scenario>/.
// =========================================================================
{
    //////////////////////////////////////
    // SCENARIOS - su cosa si confrontano.
    //   uno    -> un solo confronto
    //   piu'   -> un confronto per scenario, poi la panoramica aggregata
    // Gli scenari gia' valutati vengono saltati: rilanciare esegue solo cio'
    // che manca. Per rifarne uno, cancellare la sua cartella sotto output.
    //////////////////////////////////////
    "scenarios": [
        "P-8192/SB-8192-TEST/scenario_0",
        "P-8192/SB-8192-TEST/scenario_1",
        "P-8192/SB-8192-TEST/scenario_2",
        "P-8192/SB-8192-TEST/scenario_3",
        "P-8192/SB-8192-TEST/scenario_4",
        "P-8192/SB-8192-TEST/scenario_5",
        "P-8192/SB-8192-TEST/scenario_6",
        "P-8192/SB-8192-TEST/scenario_7",
        "P-8192/SB-8192-TEST/scenario_8",
        "P-8192/SB-8192-TEST/scenario_9"
    ],

    //////////////////////////////////////
    // CANDIDATES - chi si confronta. Scritti una volta sola.
    //   policy: "baseline" (resta sull'origine) | "random" | "mappo"
    //   model : cartella sotto data/models/mappo/ (solo per mappo)
    //   {scenario} viene sostituito con il nome dello scenario in esame,
    //             cosi' lo specialista lo segue senza riscrivere la lista.
    //////////////////////////////////////
    "candidates": [
        { "name": "lambda_scaling",              "policy": "mappo", "model": "NO-MASK/SB-8192/generalization/lambda_scaling" },
        { "name": "lambda_scaling-MASK",         "policy": "mappo", "model": "MASK/SB-8192-MASK/generalization/lambda_scaling" },
    ],

    //////////////////////////////////////
    // OUTPUT - cartella sotto data/results/evaluation/
    //////////////////////////////////////
    "output": "EVAL-8192-MASK_VS_NO_LAMBDA"
}
